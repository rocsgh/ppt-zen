# PPT-Zen image generation — point at ANY OpenAI-compatible images endpoint.
# PPT-Zen 图像生成：指向任意 OpenAI 兼容的图像接口（不绑定任何具体厂商）。
#
# Copy this file to .env and fill in your own key. .env is gitignored — never commit it.
# 复制本文件为 .env 并填入你自己的 key。.env 已被 gitignore，切勿提交。

IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=sk-your-key-here
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
